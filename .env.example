# Copy this file to .env and fill in your own values. .env is ignored by git.

# Name for the TV in the webOS CLI (any short word)
TV_NAME=tv

# IP address of the TV on your network (shown in the Developer Mode app)
TV_IP=192.168.1.50

# Passphrase shown in the Developer Mode app after you turn on Key Server
TV_PASSPHRASE=ABC123
